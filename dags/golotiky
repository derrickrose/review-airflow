with DAG(
    dag_id=DAG_ID,
    description=(
        "rts24 market events data processing - triggered by the completion of trading "
        "and order data processing, representing the availability of the consolidated "
        "market events data for the day"
    ),
    start_date=DAG_START_DATE,
    schedule=reduce(
        and_,
        [
            trd_blk_asset,
            trd_equ_asset,
            trd_etf_asset,
            trd_fxi_asset,
            trd_war_asset,
            Euronext_SLC_outlet_asset,
        ],
    ),
    catchup=False,
    max_active_runs=DAG_MAX_ACTIVE_RUNS,
    tags=TAGS,
    doc_md=__doc__,
):
    extract_trading_date_task = extract_trading_date()

    generate_files_on_demand_only_flow_task = EmptyOperator(
        task_id="generate_files_on_demand_only_flow"
    )
    load_flow_task = EmptyOperator(task_id="load_flow")
    on_demand_file_generation_load_completion_gate_task = EmptyOperator(
        task_id="on_demand_file_generation_load_completion_gate",
        # Requires every load task to succeed; skipped tasks keep this gate closed
        trigger_rule=TriggerRule.ALL_SUCCESS,
    )

    segment_flows = create_all_flows()
    all_load_tasks = [task for flow in segment_flows for task in flow.load_tasks]
    generation_tasks = [flow.generation_task for flow in segment_flows]

    route_flow_task = BranchPythonOperator(
        task_id="route_flow",
        python_callable=route_flow,
    )

    generate_files_only_flow_and_route_by_segment_task = BranchPythonOperator(
        task_id="generate_files_only_flow_and_route_by_segment",
        python_callable=generate_files_only_flow_and_route_by_segment,
    )

    route_load_by_segment_task = BranchPythonOperator(
        task_id="route_load_by_segment",
        python_callable=route_load_by_segment,
    )

    extract_trading_date_task >> route_flow_task

    application_id_template, execution_role_template, _ = get_emr_runtime_templates()

    with TaskGroup(group_id=ON_DEMAND_GROUP_ID):
        query_on_demand_table_task = AthenaOperator(
            task_id="query_table",
            query=f"SELECT * FROM {ONDEMAND_REQUESTS_TABLE} WHERE run_flag = '{RUN_FLAG_PENDING}'",
            database=LAKEHOUSE_DATABASE,
            workgroup=ATHENA_WORKGROUP,
            trigger_rule=TriggerRule.NONE_FAILED_MIN_ONE_SUCCESS,
            deferrable=True,
            aws_conn_id=AWS_CONN_ID,
        )

        process_on_demand_query_results_task = process_on_demand_query_results()

        generate_on_demand_files_task = EmrServerlessStartJobOperator.partial(
            task_id="generate_files",
            map_index_template="{{ task.name }}",
            application_id=application_id_template,
            execution_role_arn=execution_role_template,
            deferrable=True,
            on_execute_callback=log_emr_job_start,
            config={"tags": EMR_CONFIG_TAGS},
            **EMR_RETRY_POLICY,
        ).expand_kwargs(process_on_demand_query_results_task)

        mark_on_demand_requests_completed_task = mark_on_demand_requests_completed()
        confirm_on_demand_requests_completed_task = (
            confirm_on_demand_requests_completed()
        )

    generate_files_replay_only_flow_task = generate_files_replay_only_flow()
    generate_files_replay_mode_task = EmrServerlessStartJobOperator.partial(
        task_id="generate_files_replay_mode",
        map_index_template="{{ task.name }}",
        application_id=application_id_template,
        execution_role_arn=execution_role_template,
        deferrable=True,
        on_execute_callback=log_emr_job_start,
        config={"tags": EMR_CONFIG_TAGS},
        **EMR_RETRY_POLICY,
    ).expand_kwargs(generate_files_replay_only_flow_task)

    route_flow_task >> load_flow_task >> route_load_by_segment_task >> [*all_load_tasks]
    [*all_load_tasks] >> on_demand_file_generation_load_completion_gate_task

    (
        route_flow_task
        >> generate_files_only_flow_and_route_by_segment_task
        >> [*generation_tasks]
    )
    route_flow_task >> generate_files_on_demand_only_flow_task
    (
        route_flow_task
        >> generate_files_replay_only_flow_task
        >> generate_files_replay_mode_task
    )

    on_demand_file_generation_load_completion_gate_task >> query_on_demand_table_task
    generate_files_on_demand_only_flow_task >> query_on_demand_table_task
    query_on_demand_table_task >> process_on_demand_query_results_task

    (
        process_on_demand_query_results_task
        >> generate_on_demand_files_task
        >> mark_on_demand_requests_completed_task
        >> confirm_on_demand_requests_completed_task
    )
