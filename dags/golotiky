def build_event_families_by_segment() -> Dict[str, List[Tuple[str, str]]]:
    """Derive {segment: [(family, job_name), ...]} from the two source maps.

    Validates at import time: a segment that references a family missing from
    the EVENT_FAMILIES catalog fails the DAG to load (a clear import error)
    rather than silently dropping a job and producing an incomplete report.
    """
    derived: Dict[str, List[Tuple[str, str]]] = {}
    for segment, families in SEGMENT_EVENT_FAMILIES.items():
        pairs: List[Tuple[str, str]] = []
        for family in families:
            event_family = EVENT_FAMILIES.get(family)
            if event_family is None:
                raise ValueError(
                    f"Segment '{segment}' references unknown event family "
                    f"'{family}' not present in EVENT_FAMILIES."
                )
            pairs.append((family, event_family["job_name"]))
        derived[segment] = pairs
    return derived


EVENT_FAMILIES_BY_SEGMENT: Dict[str, List[Tuple[str, str]]] = (
    build_event_families_by_segment()
)


