@task
def extract_trading_date(**context) -> str:
    """Resolve trading date from manual conf first, otherwise from triggering asset events."""
    dag_run = context.get("dag_run")
    conf = dag_run.conf if dag_run else {}
    run_type = dag_run.run_type.value if dag_run else "unknown"

    logger.info(LOG_SEPARATOR)
    logger.info(
        f"Determining trading date for RTS24 report generation (trigger: {run_type})"
    )
    logger.info(LOG_SEPARATOR)

    if run_type == "manual":
        logger.info("Manual trigger detected - validating user-provided trading_date")
        logger.info(f"Configuration input: {conf}")

        try:
            trading_date = extract_trading_date_from_manual_trigger_conf(conf)
            logger.info(
                f"Manual trigger validated - will process data for {trading_date}"
            )
        except ValueError as exc:
            raise_logged_value_error("VALIDATION_ERROR", str(exc))

    else:
        logger.info(
            "Scheduled trigger detected - extracting trading_date from upstream asset events"
        )
        triggering_asset_events = context.get("triggering_asset_events", {})

        try:
            trading_date = extract_trading_date_from_asset_events(
                triggering_asset_events
            )
            if not is_valid_date(trading_date):
                raise ValueError(
                    f"Invalid '{TRADING_DATE}' from triggering asset events: {trading_date}. "
                    f"Expected {DATE_FORMAT}"
                )
            logger.info(
                f"Scheduled trigger validated - will process data for {trading_date}"
            )
        except ValueError as exc:
            raise_logged_value_error("EXTRACTION_ERROR", str(exc))

    logger.info(LOG_SEPARATOR)
    logger.info(f"Trading date confirmed: {trading_date}")
    logger.info(f"Configured load scope (by segment): {format_configured_scope()}")
    logger.info(LOG_SEPARATOR)
    return trading_date


@task(task_id="process_query_results")
def process_on_demand_query_results(**context):
    """Process Athena query results and build EMR params for dynamic mapping."""
    ti = context["ti"]
    trading_date = ti.xcom_pull(task_ids="extract_trading_date")
    query_execution_id = ti.xcom_pull(task_ids=QUERY_ON_DEMAND_TABLE_TASK_ID)

    # Ensure string type for JSON serialization in downstream dynamic mapping
    trading_date = str(trading_date)

    log_section("Processing on-demand requests query results")
    logger.info(f"Query execution ID: {query_execution_id}")

    athena_hook = AthenaHook(aws_conn_id=AWS_CONN_ID)

    job_params = []
    request_ids = []  # Collect IDs for later update
    paginator = athena_hook.get_query_results_paginator(query_execution_id)
    request_count = 0

    for data_cells, column_names in iter_athena_data_rows(paginator):
        row_data = {
            (column_names[i] if i < len(column_names) else f"col_{i}"): cell.get(
                "VarCharValue"
            )
            for i, cell in enumerate(data_cells)
        }

        request_count += 1

        # Log a concise business summary using only present filters.
        log_parts = [f"Request #{request_count}: Generate RTS24 files"]
        if row_data.get("trading_date"):
            log_parts.append(f"date={row_data.get('trading_date')}")
        if row_data.get("mic_code"):
            log_parts.append(f"MIC={row_data.get('mic_code')}")
        if row_data.get("isin_code"):
            log_parts.append(f"ISIN={row_data.get('isin_code')}")
        if row_data.get("participant_id"):
            log_parts.append(f"Participant={row_data.get('participant_id')}")

        logger.info(" | ".join(log_parts))
        logger.debug(
            f"Request #{request_count} raw data: {json.dumps(row_data, ensure_ascii=False)}"
        )

        emr_params = build_on_demand_emr_params(row_data, trading_date)
        if emr_params:
            job_params.append(emr_params)
            logger.info(
                f"Request #{request_count}: EMR job parameters prepared - {emr_params.get('name', 'unknown')}"
            )
            # Collect IDs only for rows that produced an EMR job payload.
            request_id = row_data.get("id")
            if request_id:
                request_ids.append(request_id)

    log_section("On-demand request processing summary")
    if job_params:
        logger.info(
            f"Prepared {len(job_params)} EMR job parameter set(s) from pending request(s)"
        )
        logger.info("Launch happens downstream in the generate_files task")
    else:
        logger.info("No pending regeneration requests found (run_flag='0')")
        logger.info("Skipping on-demand file generation - no work to perform")

    # Store IDs separately for update task
    ti.xcom_push(key="request_ids", value=request_ids)

    return job_params


@task(
    task_id="mark_requests_completed",
    retries=3,
    retry_delay=timedelta(minutes=1),
    retry_exponential_backoff=True,
    max_retry_delay=timedelta(minutes=30),
)
def mark_on_demand_requests_completed(**context):
    """Update run_flag to 2 for all processed on-demand requests using ID column.

    Also capture Iceberg snapshot before update.
    """
    ti = context["ti"]

    request_ids = ti.xcom_pull(
        task_ids=PROCESS_ON_DEMAND_RESULTS_TASK_ID, key="request_ids"
    )
    if not request_ids:
        logger.info("No request IDs found to update.")
        return

    athena_hook = AthenaHook(aws_conn_id=AWS_CONN_ID)
    ids_str = build_sql_in_clause(request_ids)

    # Single UTC clock read so run_date and run_timestamp stay consistent.
    now_utc = timezone.utcnow()
    run_date = now_utc.strftime("%Y-%m-%d")
    run_timestamp = now_utc.strftime("%Y-%m-%d %H:%M:%S%z")

    update_query = (
        f"UPDATE {ONDEMAND_REQUESTS_TABLE} "
        f"SET run_flag = '{RUN_FLAG_COMPLETED}', "
        f"run_date = DATE '{run_date}', "
        f"run_timestamp = '{run_timestamp}' "
        f"WHERE run_flag = '{RUN_FLAG_PENDING}' "
        f"AND id IN ({ids_str})"
    )

    logger.info(f"Batch updating {len(request_ids)} on-demand request(s)")
    logger.info(f"  run_flag = '{RUN_FLAG_COMPLETED}'")
    logger.info(f"  run_date = {run_date}")
    logger.info(f"  run_timestamp = {run_timestamp}")
    logger.info(f"Update query: {update_query}")

    # wait=True polls until terminal state and raises on non-success,
    # guaranteeing the write committed before verification runs.
    run_athena_query(athena_hook, update_query, wait=True)
    logger.info(
        f"Update committed for {len(request_ids)} on-demand request(s). Verification will follow."
    )


@task(task_id="confirm_requests_completed")
def confirm_on_demand_requests_completed(**context):
    """Verify completion with a strict expected-vs-actual count check."""
    ti = context["ti"]

    # Get IDs from the process_on_demand_query_results task
    request_ids = ti.xcom_pull(
        task_ids=PROCESS_ON_DEMAND_RESULTS_TASK_ID, key="request_ids"
    )

    if not request_ids:
        logger.info("No request IDs to verify.")
        return

    athena_hook = AthenaHook(aws_conn_id=AWS_CONN_ID)

    ids_str = build_sql_in_clause(request_ids)

    count_query = (
        "SELECT COUNT(*) AS completed_count "
        f"FROM {ONDEMAND_REQUESTS_TABLE} "
        f"WHERE run_flag = '{RUN_FLAG_COMPLETED}' "
        f"AND id IN ({ids_str})"
    )

    log_section("Verifying completion status for processed requests")
    logger.info("Running completion count verification query")
    logger.info(f"Verification query: {count_query}")

    count_query_execution_id = run_athena_query(athena_hook, count_query)

    # Retrieve completed count from Athena result set
    paginator = athena_hook.get_query_results_paginator(count_query_execution_id)
    completed_count = 0

    for data_cells, _ in iter_athena_data_rows(paginator):
        if data_cells:
            completed_count = int(data_cells[0].get("VarCharValue") or 0)
        break

    expected_count = len(request_ids)

    log_section("Completion verification summary")
    logger.info(f"Expected completed requests: {expected_count}")
    logger.info(f"Actual completed requests: {completed_count}")
    logger.info(f"Difference: {expected_count - completed_count}")

    if completed_count != expected_count:
        logger.error(
            f"Completion verification failed: expected {expected_count} completed request(s), found {completed_count}."
        )
        logger.error(
            "Operational action: review update task logs and Athena table partitions for run_flag='0' and run_flag='2'."
        )
        raise ValueError(
            "Update verification failed: "
            f"expected {expected_count} completed rows but found {completed_count}."
        )
    else:
        logger.info(
            f"Completion verification succeeded: all {expected_count} processed request(s) are marked as completed."
        )


@task(task_id="generate_files_replay_only_flow")
def generate_files_replay_only_flow(**context) -> List[Dict[str, Any]]:
    """Build dynamic EMR parameters for replay mode from replay input in dag_run.conf."""
    conf = get_conf(context)
    ti = context["ti"]
    trading_date = str(ti.xcom_pull(task_ids="extract_trading_date"))

    replay_items = parse_replay_params(conf)
    params: List[Dict[str, Any]] = []

    if not replay_items:
        # Default replay with no filters to one mapped run per supported segment.
        replay_items = [
            {"segment": segment_code, "optiq_segment_id": segment_id}
            for segment_code, segment_id in SEGMENT_CODE_TO_ID.items()
        ]
        logger.info(
            f"Replay mode received no replay filters; defaulting to all segments: {list(SEGMENT_CODE_TO_ID.keys())}"
        )

    for replay_item in replay_items:
        params.append(build_replay_emr_params(replay_item, trading_date))

    logger.info(
        f"Replay mode built {len(params)} EMR mapped task(s) from replay input: {replay_items}"
    )
    return params


