def truncate_emr_job_name(name: str) -> str:
    """Truncate an EMR job name to the EMR Serverless limit at a delimiter.

    Cuts to the max length, then back to the last '-' or '_' so the truncated
    name stays semantically readable. If there is no delimiter past the start,
    the hard-cut name is returned as-is.
    """
    if len(name) <= EMR_JOB_NAME_MAX_LEN:
        return name
    truncated = name[:EMR_JOB_NAME_MAX_LEN]
    last_sep = max(truncated.rfind("-"), truncated.rfind("_"))
    return truncated[:last_sep] if last_sep > 0 else truncated


def build_spark_args(pairs: Dict[str, Any]) -> List[str]:
    """Flatten {flag: value} into a [flag, value, flag, value, ...] arg list.

    Values that are None or empty/whitespace-only strings are skipped entirely
    (the flag is omitted), which is how optional arguments are expressed. The
    Spark entrypoints parse these with argparse, so flag order is irrelevant.
    """
    args: List[str] = []
    for flag, value in pairs.items():
        if value is None:
            continue
        text = str(value)
        if text.strip() == "":
            continue
        args.extend([flag, text])
    return args


def build_spark_driver(job_base_path: str, args: List[str]) -> Dict[str, Any]:
    """Wrap entrypoint args in the standard EMR Serverless sparkSubmit driver."""
    return {
        "sparkSubmit": {
            "entryPoint": f"{job_base_path}/{JOB_ENTRYPOINT_FILE}",
            "sparkSubmitParameters": SPARK_SUBMIT_PARAMETERS,
            "entryPointArguments": args,
        }
    }


