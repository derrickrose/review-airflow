def log_section(title: str) -> None:
    """Log a titled section delimited by the standard separator."""
    logger.info(LOG_SEPARATOR)
    logger.info(title)
    logger.info(LOG_SEPARATOR)


def raise_logged_value_error(prefix: str, message: str) -> None:
    """Log a formatted error section and raise a ValueError."""
    logger.info(LOG_SEPARATOR)
    logger.info(f"{prefix}: {message}")
    logger.info(LOG_SEPARATOR)
    raise ValueError(message)


def format_configured_scope() -> str:
    """Summarize the configured event-family count per segment.

    Derived from EVENT_FAMILIES_BY_SEGMENT so the figure can never drift from
    the actual configuration. Describes what is configured/available, not the
    scope of any particular run (which depends on the resolved mode).
    """
    return ", ".join(
        f"{segment}={len(families)}"
        for segment, families in EVENT_FAMILIES_BY_SEGMENT.items()
    )


def is_valid_date(date_str: str) -> bool:
    """Check if date string matches expected format (YYYY-MM-DD)."""
    try:
        datetime.strptime(date_str, DATE_FORMAT)
        return True
    except (ValueError, TypeError):
        return False


def normalize_optional_str(value: Any) -> Optional[str]:
    """Normalize a raw value to a non-empty stripped string, else None.

    Non-string values are coerced via str(); empty/whitespace-only strings
    become None. Mirrors the behavior previously duplicated in the on-demand
    row reader and the replay scalar normalizer.
    """
    if value is None:
        return None
    if isinstance(value, str):
        stripped = value.strip()
        return stripped if stripped != "" else None
    return str(value)


def normalize_and_deduplicate(
    items: List[Any], transform: Callable[[str], str]
) -> List[str]:
    """Strip, transform and deduplicate a list of raw items, filtering empty strings."""
    seen: set = set()
    result: List[str] = []
    for item in items:
        normalized = transform(str(item).strip())
        if normalized and normalized not in seen:
            seen.add(normalized)
            result.append(normalized)
    return result


def parse_str_or_list_field(
    raw_value: Any, field_name: str, context_name: str
) -> List[str]:
    """Parse a conf field that accepts a comma-separated string or a list."""
    if isinstance(raw_value, str):
        return raw_value.split(",")
    if isinstance(raw_value, list):
        return raw_value
    raise_logged_value_error(
        "VALIDATION_ERROR",
        f"Invalid '{field_name}' type in {context_name}. Use a comma-separated string or a list.",
    )
    return []  # unreachable; raise_logged_value_error always raises


def validate_and_register_segment(
    segment_raw: Any,
    valid_segments: set,
    seen_segments: set,
    context_name: str,
) -> str:
    """Validate, normalize and register a segment code; raises on invalid or duplicate."""
    if not segment_raw:
        raise_logged_value_error(
            "VALIDATION_ERROR",
            f"Each item in '{context_name}' must include a non-empty 'segment'.",
        )
    segment_code = str(segment_raw).strip().upper()
    if segment_code not in valid_segments:
        raise_logged_value_error(
            "VALIDATION_ERROR",
            f"Invalid segment in '{context_name}': {segment_code}. Allowed values: {sorted(valid_segments)}.",
        )
    if segment_code in seen_segments:
        raise_logged_value_error(
            "VALIDATION_ERROR",
            f"Duplicate segment '{segment_code}' in '{context_name}'. Provide each segment at most once.",
        )
    seen_segments.add(segment_code)
    return segment_code


def build_sql_in_clause(ids: List[Any]) -> str:
    """Build a comma-separated SQL IN clause with single-quoted, escaped string values."""
    escaped = [str(id_val).replace("'", "''") for id_val in ids]
    return ",".join(f"'{v}'" for v in escaped)


