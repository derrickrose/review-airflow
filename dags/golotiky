def parse_selected_segments(conf: Dict[str, Any]) -> List[str]:
    """Parse and validate selected segments from dag_run.conf.

    Validation is strict for all modes to fail early and avoid wasting EMR
    resources on invalid manual trigger input.
    """
    segments_raw = conf.get("segments")
    valid_segments = list(SEGMENT_CODE_TO_ID.keys())
    valid_segments_set = set(valid_segments)

    if segments_raw is None:
        logger.info(
            f"No 'segments' provided in dag_run.conf - defaulting to all segments: {valid_segments}"
        )
        return valid_segments

    selected_segments = normalize_and_deduplicate(
        parse_str_or_list_field(segments_raw, "segments", "dag_run.conf"), str.upper
    )

    if not selected_segments:
        raise_logged_value_error(
            "VALIDATION_ERROR",
            "'segments' is empty. Provide at least one segment among: EQU, ETF, FXI, WAR, BLK.",
        )

    invalid_segments = [
        segment for segment in selected_segments if segment not in valid_segments_set
    ]
    if invalid_segments:
        raise_logged_value_error(
            "VALIDATION_ERROR",
            f"Invalid segment code(s): {invalid_segments}. Allowed values: {valid_segments}.",
        )

    logger.info(f"Validated selected segments from dag_run.conf: {selected_segments}")
    return selected_segments


def parse_selected_event_families(
    conf: Dict[str, Any], selected_segments: List[str]
) -> List[str]:
    """Parse and validate selected event families from dag_run.conf for load mode.

    Validation is segment-aware to support future divergence in available event
    families across segments.
    """
    event_families_raw = conf.get("event_families")

    valid_event_families = []
    seen_valid = set()
    for segment_code in selected_segments:
        for flow_name, _ in EVENT_FAMILIES_BY_SEGMENT.get(segment_code, []):
            if flow_name not in seen_valid:
                seen_valid.add(flow_name)
                valid_event_families.append(flow_name)

    valid_event_families_set = set(valid_event_families)

    if event_families_raw is None:
        logger.info(
            f"No 'event_families' provided in dag_run.conf - defaulting to all event families: {valid_event_families}"
        )
        return valid_event_families

    selected_event_families = normalize_and_deduplicate(
        parse_str_or_list_field(event_families_raw, "event_families", "dag_run.conf"),
        str.lower,
    )

    if not selected_event_families:
        raise_logged_value_error(
            "VALIDATION_ERROR",
            "'event_families' is empty. Provide at least one family among: "
            f"{valid_event_families}.",
        )

    invalid_event_families = [
        event_family
        for event_family in selected_event_families
        if event_family not in valid_event_families_set
    ]
    if invalid_event_families:
        raise_logged_value_error(
            "VALIDATION_ERROR",
            f"Invalid event_families value(s): {invalid_event_families}. "
            f"Allowed values: {valid_event_families}.",
        )

    logger.info(
        f"Validated selected event families from dag_run.conf: {selected_event_families}"
    )
    return selected_event_families


def validate_event_families_per_segment(
    segment_code: str, selected_event_families: List[str]
) -> List[str]:
    """Return event families requested but unavailable for one segment."""
    available_families = {
        flow_name for flow_name, _ in EVENT_FAMILIES_BY_SEGMENT.get(segment_code, [])
    }
    return [
        family for family in selected_event_families if family not in available_families
    ]


def validate_event_families(
    selected_segments: List[str], selected_event_families: List[str]
) -> Dict[str, List[str]]:
    """Validate global event families across selected segments.

    Global mode is permissive for operations: unsupported combinations are
    reported and skipped, while valid combinations continue to run.
    """
    missing_by_segment: Dict[str, List[str]] = {}
    for segment_code in selected_segments:
        missing_families = validate_event_families_per_segment(
            segment_code, selected_event_families
        )
        if missing_families:
            missing_by_segment[segment_code] = missing_families

    if missing_by_segment:
        logger.warning(
            f"Global mode: unsupported segment/event_family combinations will be skipped: {missing_by_segment}"
        )

    return missing_by_segment


def parse_load_params(
    conf: Dict[str, Any],
) -> Dict[str, List[str]]:
    """Parse segment-specific event families from dag_run.conf.

    Accepted item format:
            - {"segment": "EQU", "event_families": [..]}
    """
    raw_entries = conf.get("load_params")
    if raw_entries is None:
        return {}

    # Accept a single-object shorthand (dict) to simplify manual triggers.
    # Preserve existing behaviour for lists while being more user-friendly.
    if isinstance(raw_entries, dict):
        raw_entries = [raw_entries]

    if not isinstance(raw_entries, list):
        raise_logged_value_error(
            "VALIDATION_ERROR",
            "Invalid 'load_params' type in dag_run.conf. Use a list of objects or a single object shorthand.",
        )

    if not raw_entries:
        raise_logged_value_error(
            "VALIDATION_ERROR",
            "'load_params' is empty. Provide at least one segment entry.",
        )

    valid_segments = set(SEGMENT_CODE_TO_ID.keys())
    parsed: Dict[str, List[str]] = {}
    seen_segments: set[str] = set()

    for entry in raw_entries:
        if not isinstance(entry, dict):
            raise_logged_value_error(
                "VALIDATION_ERROR",
                "Each item in 'load_params' must be an object with 'segment' and event families.",
            )

        segment_code = validate_and_register_segment(
            entry.get("segment"),
            valid_segments,
            seen_segments,
            "load_params",
        )

        candidate_families = parse_str_or_list_field(
            entry.get("event_families"),
            "event_families",
            "load_params entry",
        )

        normalized_families = normalize_and_deduplicate(candidate_families, str.lower)

        if not normalized_families:
            raise_logged_value_error(
                "VALIDATION_ERROR",
                f"Segment {segment_code} has empty event families in 'load_params'.",
            )

        missing = validate_event_families_per_segment(segment_code, normalized_families)
        if missing:
            raise_logged_value_error(
                "VALIDATION_ERROR",
                (
                    f"Segment {segment_code} does not support requested event_families: {missing}."
                ),
            )

        parsed[segment_code] = normalized_families

    logger.info(f"Validated load_params: {parsed}")
    return parsed


def normalize_replay_items(conf: Dict[str, Any]) -> List[Dict[str, Any]]:
    """Resolve and validate replay items from dag_run.conf.

    Single source of truth shared by replay validation and parsing so that all
    three input shapes are treated identically:
        - replay_params as a list of objects
        - replay_params as a single object (coerced to a one-item list)
        - flattened root-level filter keys (when replay_params is absent)

    Validates that each resolved item is an object containing only allowed
    filter keys, and returns the canonical list of item dicts. Returns an empty
    list when no replay filters are provided at all (caller decides the default).
    """
    raw_entries = conf.get("replay_params")

    if raw_entries is None:
        # Flattened root-level form: build a single item from root filter keys.
        flattened_entry = {
            key: conf.get(key)
            for key in REPLAY_ALLOWED_ITEM_KEYS
            if conf.get(key) is not None
        }
        if not flattened_entry:
            return []
        entries: List[Any] = [flattened_entry]
    elif isinstance(raw_entries, dict):
        # Single-object shorthand -> one-item list.
        entries = [raw_entries]
    elif isinstance(raw_entries, list):
        entries = raw_entries
    else:
        raise_logged_value_error(
            "VALIDATION_ERROR",
            "Invalid 'replay_params' type in dag_run.conf. Use a list of objects or a single object shorthand.",
        )

    for index, entry in enumerate(entries):
        if not isinstance(entry, dict):
            raise_logged_value_error(
                "VALIDATION_ERROR",
                f"Invalid replay item at index {index}. Each item must be an object.",
            )
        unknown_item_keys = sorted(set(entry.keys()) - REPLAY_ALLOWED_ITEM_KEYS)
        if unknown_item_keys:
            raise_logged_value_error(
                "VALIDATION_ERROR",
                f"Replay mode received unknown filter key(s) at index {index}: {unknown_item_keys}.",
            )

    return entries


def validate_replay_conf(conf: Dict[str, Any]) -> None:
    """Validate replay-mode payload strictly and fail fast on unknown input."""
    trading_date = conf.get(TRADING_DATE)
    if not trading_date:
        raise_logged_value_error(
            "VALIDATION_ERROR",
            f"Replay mode requires a non-empty '{TRADING_DATE}' in dag_run.conf.",
        )
    if not is_valid_date(str(trading_date)):
        raise_logged_value_error(
            "VALIDATION_ERROR",
            (
                f"Invalid replay trading_date: {trading_date}. "
                f"Expected format: {DATE_FORMAT}."
            ),
        )

    unknown_root_keys = sorted(set(conf.keys()) - REPLAY_ALLOWED_ROOT_KEYS)
    if unknown_root_keys:
        raise_logged_value_error(
            "VALIDATION_ERROR",
            f"Replay mode received unknown dag_run.conf key(s): {unknown_root_keys}.",
        )

    # Resolve and strictly validate items for ALL input shapes (list,
    # single-object shorthand, and flattened root-level filters). The result is
    # discarded here; parsing re-derives it. Centralizing in one helper keeps
    # validation and parsing from drifting and ensures the flattened form is
    # validated identically to replay_params.
    normalize_replay_items(conf)


def parse_replay_params(conf: Dict[str, Any]) -> List[Dict[str, Any]]:
    """Parse replay request items for dynamic mapping.

    Replay accepts a permissive list payload where each item becomes one
    mapped EMR request, similar to the on-demand query row model.

    Accepted fields per replay item:
        - segment (preferred; mapped to optiq segment id)
        - mic_code, isin_code, participant_id
    """
    raw_entries = normalize_replay_items(conf)
    if not raw_entries:
        return []
    if conf.get("replay_params") is None:
        logger.info("Replay scope resolved from flattened root-level filters")

    def parse_values(value: Any, to_upper: bool = False) -> List[Optional[str]]:
        """Parse scalar/list/comma-separated value into normalized values.

        Returns [None] when value is missing/empty so other dimensions still map.
        """
        if value is None:
            return [None]

        if isinstance(value, list):
            candidates = [normalize_optional_str(v) for v in value]
        elif isinstance(value, str):
            candidates = [normalize_optional_str(v) for v in value.split(",")]
        else:
            candidates = [normalize_optional_str(value)]

        normalized = [v.upper() if (v and to_upper) else v for v in candidates if v]
        return normalized if normalized else [None]

    parsed: List[Dict[str, Any]] = []
    for entry in raw_entries:
        segment_values = parse_values(entry.get("segment", entry.get("segments")), True)
        mic_values = parse_values(entry.get("mic_code", entry.get("mic_codes")))
        isin_values = parse_values(entry.get("isin_code", entry.get("isin_codes")))
        participant_values = parse_values(
            entry.get("participant_id", entry.get("participant_ids"))
        )

        for segment_code in segment_values:
            for mic_code in mic_values:
                for isin_code in isin_values:
                    for participant_id in participant_values:
                        normalized: Dict[str, Any] = {}

                        if segment_code:
                            normalized["segment"] = segment_code
                            optiq_segment_id = SEGMENT_CODE_TO_ID.get(segment_code)
                            if optiq_segment_id:
                                normalized["optiq_segment_id"] = optiq_segment_id

                        if mic_code:
                            normalized["mic_code"] = mic_code
                        if isin_code:
                            normalized["isin_code"] = isin_code
                        if participant_id:
                            normalized["participant_id"] = participant_id

                        parsed.append(normalized)

    logger.info(f"Replay scope: {len(parsed)} generation run(s) resolved")
    return parsed


# ==============================================================================
# Flow Routing
# ==============================================================================

# Per-mode routing for the "skip-load" modes. Each entry is
# (validator, branch_target, log_message); validator may be None when a mode has
# no pre-branch validation (it validates later in its own flow task). LOAD is
# intentionally absent: it is the default path and is handled directly in
# route_flow so it can log its parsed segment selection.
MODE_ROUTING: Dict[
    ProcessingMode, Tuple[Optional[Callable[[Dict[str, Any]], None]], str, str]
] = {
    ProcessingMode.GENERATE_FILES: (
        None,
        "generate_files_only_flow_and_route_by_segment",
        "Processing mode is generate_files - skipping load tasks and running generation tasks only",
    ),
    ProcessingMode.ON_DEMAND: (
        None,
        "generate_files_on_demand_only_flow",
        "Processing mode is on_demand - skipping load and regular generation, running on-demand flow only",
    ),
    ProcessingMode.REPLAY: (
        validate_replay_conf,
        "generate_files_replay_only_flow",
        "Processing mode is replay - running replay generation flow only",
    ),
}


def build_load_task_ids(
    families_by_segment: "Dict[str, Any]",
) -> List[str]:
    """Build load task-ids for a {segment_code: allowed_families} mapping.

    For each segment, emits one task-id per configured event family that is in
    the segment's allowed-families collection, in EVENT_FAMILIES_BY_SEGMENT
    order. Shared by both the global and per-segment load selectors.
    """
    return [
        f"load_{segment_code}_segment.run_{flow_name}_emr_job"
        for segment_code, allowed_families in families_by_segment.items()
        for flow_name, _ in EVENT_FAMILIES_BY_SEGMENT.get(segment_code, [])
        if flow_name in allowed_families
    ]


def route_flow(**context) -> List[str] | str:
    """Branch to load path or skip path based on dag_run.conf processing mode."""
    conf = get_conf(context)
    mode = ProcessingMode.from_conf(conf)

    routing = MODE_ROUTING.get(mode)
    if routing is not None:
        validator, branch_target, log_message = routing
        if validator is not None:
            validator(conf)
        logger.info(log_message)
        return branch_target

    # Default path: LOAD. Parse segments here so invalid segments fail fast.
    selected_segments = parse_selected_segments(conf)
    logger.info(
        f"Processing mode is {mode.value} - running load flow for segments {selected_segments} before generation"
    )
    return "load_flow"


def route_load_by_segment(**context) -> List[str]:
    """Route load flow to selected segment/event-family load tasks after prerequisites."""
    conf = get_conf(context)
    selected_by_segment = parse_load_params(conf)
    selected_task_ids: List[str] = []

    # Merge mode: if any global filters are explicitly provided, include the
    # global path even when segment-specific filters are also present.
    has_explicit_global_filters = (
        conf.get("segments") is not None or conf.get("event_families") is not None
    )

    if not selected_by_segment or has_explicit_global_filters:
        selected_segments = parse_selected_segments(conf)
        selected_event_families = parse_selected_event_families(conf, selected_segments)
        # validate_event_families logs any unsupported (skipped) combinations itself.
        validate_event_families(selected_segments, selected_event_families)

        # Same allowed-family set applies to every selected segment.
        selected_task_ids.extend(
            build_load_task_ids(
                {
                    segment_code: selected_event_families
                    for segment_code in selected_segments
                }
            )
        )

        logger.info(
            f"Global load selection - segments {selected_segments} and event families"
            f" {selected_event_families} produced tasks: {selected_task_ids}"
        )

    if selected_by_segment:
        selected_task_ids.extend(build_load_task_ids(selected_by_segment))

        logger.info(
            f"Per-segment load selection {selected_by_segment} appended tasks;"
            f" combined pre-dedup list: {selected_task_ids}"
        )

    # Preserve order while removing duplicates from merged selectors.
    deduplicated_task_ids = list(dict.fromkeys(selected_task_ids))

    # Fail fast if the selection resolved to zero tasks. Returning an empty list
    # to a BranchPythonOperator silently skips all downstream load tasks and the
    # run goes green having done nothing.
    if not deduplicated_task_ids:
        raise_logged_value_error(
            "VALIDATION_ERROR",
            (
                "Load selection resolved to zero tasks. "
                f"conf segments={conf.get('segments')}, "
                f"event_families={conf.get('event_families')}, "
                f"load_params={conf.get('load_params')}."
            ),
        )

    logger.info(
        f"Final load task selection after deduplication: {deduplicated_task_ids}"
    )
    return deduplicated_task_ids


def generate_files_only_flow_and_route_by_segment(**context) -> List[str]:
    """Route generate-files-only flow to selected segment generation tasks."""
    conf = get_conf(context)
    selected_segments = parse_selected_segments(conf)

    selected_task_ids = [f"generate_{segment}_files" for segment in selected_segments]

    if not selected_task_ids:
        raise_logged_value_error(
            "VALIDATION_ERROR",
            (
                "Generate-files selection resolved to zero tasks. "
                f"conf segments={conf.get('segments')}."
            ),
        )

    logger.info(
        f"Generate-files-only flow selected segments {selected_segments} with tasks: {selected_task_ids}"
    )
    return selected_task_ids


