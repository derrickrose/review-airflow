def build_on_demand_emr_params(
    row: Dict[str, Any], trading_date: str
) -> Optional[Dict[str, Any]]:
    """Build EMR operator params for a single Athena row.

    Transforms database records into EMR job parameters for dynamic task mapping,
    enabling on-demand file generation based on user requests.
    """
    if not row:
        return None

    def get_value(column_name: str) -> Optional[str]:
        """Extract and normalize column value from row data."""
        return normalize_optional_str(row.get(column_name))

    # Reuse standard generation job for consistency with scheduled runs
    job_name = "c_reg_8_rts24_generation"
    job_base_path = f"{JOBS_BASE_PATH}/{job_name}"

    # Row-specific date overrides DAG-level for flexibility in regenerating historical data
    row_trading_date = get_value("trading_date")
    dag_trading_date = str(trading_date).strip() if trading_date is not None else None
    dag_trading_date = dag_trading_date if dag_trading_date else None
    effective_trading_date = row_trading_date or dag_trading_date

    if not effective_trading_date:
        raise_logged_value_error(
            "VALIDATION_ERROR",
            "On-demand generation requires a non-empty 'trading_date' (request row or DAG context).",
        )
    if not is_valid_date(effective_trading_date):
        raise_logged_value_error(
            "VALIDATION_ERROR",
            (
                f"Invalid on-demand trading_date: {effective_trading_date}. "
                f"Expected format: {DATE_FORMAT}."
            ),
        )

    # Optional filters for targeted file regeneration
    mic = get_value("mic_code")
    isin = get_value("isin_code")
    participant = get_value("participant_id")

    args = build_spark_args(
        {
            "--env": ENV_LOWER,
            "--trading-date": str(effective_trading_date),
            "--config": f"{job_base_path}/{JOB_CONFIG_FILE}",
            "--sql-base-path": f"{job_base_path}/{SQL_BASE_SUBPATH}",
            "--mic-code": mic,
            "--isin-code": isin,
            "--participant-id": participant,
        }
    )

    job_driver = build_spark_driver(job_base_path, args)

    # Build consistent job name: rts24-on-demand-{job_name}-key1_value1-key2_value2-trading_date
    job_name_parts = [f"rts24-on-demand-{job_name}"]
    if mic:
        job_name_parts.append(f"mic_{mic}")
    if isin:
        job_name_parts.append(f"isin_{isin}")
    if participant:
        job_name_parts.append(f"participant_{participant}")
    job_name_parts.append(str(effective_trading_date))
    name = truncate_emr_job_name("-".join(job_name_parts))

    return {"name": name, "job_driver": job_driver}


def build_replay_emr_params(
    replay_item: Dict[str, Any], trading_date: str
) -> Dict[str, Any]:
    """Build one replay EMR request from one replay_params item.

    Uses top-level trading_date and forwards only provided optional replay filters.
    """
    job_name = "c_reg_8_rts24_generation"
    job_base_path = f"{JOBS_BASE_PATH}/{job_name}"

    optiq_segment_id = replay_item.get("optiq_segment_id")
