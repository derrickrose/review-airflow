def run_athena_query(hook: AthenaHook, query: str, wait: bool = False) -> str:
    """Run a query against the lakehouse database on the standard workgroup."""
    query_execution_id = hook.run_query(
        query=query,
        query_context={"Database": LAKEHOUSE_DATABASE},
        result_configuration={},
        workgroup=ATHENA_WORKGROUP,
    )

    if wait:
        final_state = hook.poll_query_status(query_execution_id)
        if final_state != "SUCCEEDED":
            raise ValueError(
                f"Athena query {query_execution_id} did not succeed "
                f"(final state: {final_state})."
            )

    return query_execution_id


def iter_athena_data_rows(
    paginator: Any,
) -> Iterator[Tuple[List[Any], List[str]]]:
    """Yield (data_cells, column_names) for each non-header row from an Athena paginator."""
    if not paginator:
        return
    column_names: List[str] = []
    is_first_row = True
    for page in paginator:
        result_set = page.get("ResultSet", {})
        if not column_names:
            column_info = result_set.get("ResultSetMetadata", {}).get("ColumnInfo", [])
            column_names = [c.get("Name") for c in column_info] if column_info else []
        for row in result_set.get("Rows", []):
            if is_first_row:
                is_first_row = False
                continue
            yield row.get("Data", []), column_names


