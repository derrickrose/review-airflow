class ProcessingMode(Enum):
    LOAD = "load"
    GENERATE_FILES = "generate_files"
    ON_DEMAND = "on_demand"
    REPLAY = "replay"

    @classmethod
    def from_conf(cls, conf: "Dict[str, Any]") -> "ProcessingMode":
        """Resolve the processing mode from dag_run.conf.

        Accepts either 'processing_mode' or 'mode', normalizes case/whitespace,
        and defaults to LOAD when neither is provided. Raises (via the standard
        logged error) on an unrecognized value, matching the strict validation
        used elsewhere for manual-trigger input.
        """
        raw = conf.get("processing_mode") or conf.get("mode")
        value = str(raw).strip().lower() if raw is not None else cls.LOAD.value
        try:
            return cls(value)
        except ValueError:
            allowed = [mode.value for mode in cls]
            raise_logged_value_error(
                "VALIDATION_ERROR",
                f"Invalid 'processing_mode': {value}. Allowed values: {allowed}.",
            )
            raise  # unreachable; raise_logged_value_error always raises


class SegmentFlow(NamedTuple):
