"""
Resolve trading_date and run per-segment EMR flows.

- Extract `trading_date` from manual `dag_run.conf` or triggering asset events
  and validate consistency across assets.
- Create a TaskGroup per segment (`process_segment_<SEG>`); run per-flow EMR jobs,
  then a per-segment generation job.
- Inputs: triggering asset events or `dag_run.conf`.
- Outputs: EMR Serverless Spark jobs per (segment, flow) and a per-segment generation job.
"""

import json
import logging
import os
import boto3
