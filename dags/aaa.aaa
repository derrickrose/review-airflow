LOG_SEPARATOR = "=" * 80
logger = logging.getLogger("airflow.task")


# ==============================================================================
# Logging & Validation Helpers
# ==============================================================================

def log_section(title: str) -> None:
    """Log a titled section delimited by the standard separator."""
    logger.info(LOG_SEPARATOR)
    logger.info(title)
    logger.info(LOG_SEPARATOR)


def raise_logged_value_error(prefix: str, message: str) -> None:
    """Log a formatted error section and raise a ValueError."""
    logger.info(LOG_SEPARATOR)
    logger.info(f"{prefix}: {message}")
    logger.info(LOG_SEPARATOR)
    raise ValueError(message)


def is_valid_date(date_str: str) -> bool:
    """Check if date string matches expected format (YYYY-MM-DD)."""
    try:
        datetime.strptime(date_str, DATE_FORMAT)
        return True
    except (ValueError, TypeError):
        return False


def extract_trading_date_from_manual_trigger_conf(conf: Dict[str, Any]) -> str:
    """Extract and validate trading_date from manual dag_run.conf."""
    if TRADING_DATE not in conf:
        raise ValueError(
            f"Manual trigger requires '{TRADING_DATE}' in dag_run.conf. "
            f'Example: {{"{TRADING_DATE}": "2026-03-20"}}'
        )

    trading_date = conf.get(TRADING_DATE)
    if not trading_date:
        raise ValueError(
            f"Manual trigger '{TRADING_DATE}' cannot be empty. Expected format: {DATE_FORMAT}"
        )

    if not is_valid_date(trading_date):
        raise ValueError(
            f"Invalid '{TRADING_DATE}' format: {trading_date}. Expected {DATE_FORMAT}"
        )

    return trading_date


def parse_event_body(body: Any) -> Optional[Dict[str, Any]]:
    """Parse event body which may be a JSON string or already a dict.

    Returns parsed dict on success or None on parse failure/unsupported type.
    """
    if isinstance(body, dict):
        return body
    if not isinstance(body, str):
        logger.debug("Unexpected Body type in asset event: %s", type(body))
        return None

    try:
        return json.loads(body)
    except (ValueError, json.JSONDecodeError) as exc:  # JSONDecodeError subclasses ValueError
        logger.warning("Failed to parse asset event Body JSON: %s -- Body: %s", exc, body)
        return None


def extract_date_from_event(event: Any) -> Optional[str]:
    """Extract `trading_date` from a single asset event (robust to JSON/body errors)."""
    extra = getattr(event, "extra", {}) or {}

    # direct path
    trading_date = extra.get(TRADING_DATE)
    if trading_date:
        return trading_date

    # payload.message_batch[0].Body JSON path
    payload = extra.get("payload", {}) or {}
    message_batch = payload.get("message_batch", [])
    if not message_batch:
        return None

    body = message_batch[0].get("Body")
    if not body:
        return None

    parsed = parse_event_body(body)
    if not parsed:
        return None

    trading_date = parsed.get(TRADING_DATE)
    return trading_date


def extract_trading_date_from_asset_events(triggering_asset_events: Dict[Any, List[Any]]) -> str:
    """Extract and validate trading_date across all triggering asset events.

    When multiple assets trigger this DAG, ensures all assets carry the same
    trading_date. Raises if dates conflict or none found.
    """
    dates_by_asset: Dict[str, str] = {}

    for asset_key, asset_events in triggering_asset_events.items():
        for event in asset_events or []:
            trading_date = extract_date_from_event(event)
            if trading_date:
                asset_name = getattr(asset_key, "name", str(asset_key))
                dates_by_asset[asset_name] = trading_date
                break  # one date per asset is enough

    if not dates_by_asset:
        raise ValueError("No trading_date found in any triggering asset event")

    unique_dates = set(dates_by_asset.values())
    if len(unique_dates) > 1:
        raise ValueError(
            f"Conflicting trading_date across triggering assets: {dates_by_asset}. "
            f"All assets must carry the same trading_date."
        )

    trading_date = unique_dates.pop()
    logger.info(
        "trading_date=%s confirmed across %d asset(s): %s",
        trading_date,
        len(dates_by_asset),
        list(dates_by_asset.keys()),
    )
    return trading_date


@task
def extract_trading_date(**context) -> str:
    """Resolve trading date from manual conf first, otherwise from triggering asset events."""
    dag_run = context.get("dag_run")
    conf = dag_run.conf if dag_run else {}
    run_type = dag_run.run_type.value if dag_run else "unknown"
    log_section(f"EXTRACT TRADING DATE (run_type={run_type})")

    if run_type == "manual":
        log_section("MANUAL TRIGGER VALIDATION")
        logger.info("CONF_INPUT: %s", conf)

        try:
            trading_date = extract_trading_date_from_manual_trigger_conf(conf)
        except ValueError as exc:
            raise_logged_value_error("VALIDATION_ERROR", str(exc))

    else:
        log_section("ASSET TRIGGERED EXTRACTION")

        triggering_asset_events = context.get("triggering_asset_events", {})

        try:
            trading_date = extract_trading_date_from_asset_events(triggering_asset_events)
            if not is_valid_date(trading_date):
                raise ValueError(
                    f"Invalid '{TRADING_DATE}' from triggering asset events: {trading_date}. "
                    f"Expected {DATE_FORMAT}"
                )
        except ValueError as exc:
            raise_logged_value_error("EXTRACTION_ERROR", str(exc))

    log_section("EXTRACT TRADING DATE COMPLETE")
    logger.info("trading_date=%s", trading_date)
    return trading_date


def log_emr_job_start(context: Dict[str, Any]) -> None:
    """Log EMR submission details at operator runtime."""
    task = context["task"]
    spark_submit = task.job_driver.get("sparkSubmit", {})
    args = spark_submit.get("entryPointArguments", [])

    logger.info(LOG_SEPARATOR)
    logger.info("BUILD EMR JOB")
    logger.info(LOG_SEPARATOR)
    logger.info("task_id=%s", task.task_id)
    logger.info("entry_point=%s", spark_submit.get("entryPoint"))
    logger.info("spark_submit_parameters=%s", spark_submit.get("sparkSubmitParameters"))
    logger.info("arguments=%s", args)


def build_emr_job_params(
    flow_name: str,
    segment_code: str,
    segment_id: str,
    trading_date: str,
    job_name: str,
) -> Dict[str, Any]:
    """Build EMR job parameters for one flow and one segment.

    If `job_name` is provided it is used as the job folder/name; otherwise
    `flow_name` is used as a fallback for backward compatibility.
    """
    job_base = f"{JOBS_BASE_PATH}/{job_name}"

    return {
        "name": f"rts24-{segment_code}-{job_name}-{trading_date}",
        "job_driver": {
            "sparkSubmit": {
                "entryPoint": f"{job_base}/{ENTRYPOINT_FILE}",
                "sparkSubmitParameters": SPARK_SUBMIT_PARAMETERS,
                "entryPointArguments": [
                    "--trading-date",
                    trading_date,
                    "--env",
                    ENV_LOWER,
                    "--config",
                    f"{job_base}/{CONFIG_FILE}",
                    "--flow-name",
                    flow_name,
                    "--optiq-segment-id",
                    segment_id,
                    "--log-level",
                    LOG_LEVEL,
                ],
            },
        },
    }


def build_file_generation_emr_job(
    job_name: str,
    segment_code: str,
    segment_id: str,
    trading_date: str,
    dry_run: bool = False,
) -> Dict[str, Any]:
    """Build EMR job params for the file-generation job.

    Returns a dict suitable to pass into `EmrServerlessStartJobOperator`.
    """
    job_base = f"{JOBS_BASE_PATH}/{job_name}"

    args: List[str] = [
        "--env",
        ENV_LOWER,
        "--trading-date",
        trading_date,
        "--config",
        f"{job_base}/{CONFIG_FILE}",
        "--sql-base-path",
        f"{job_base}/{SQL_BASE_SUBPATH}",
        "--optiq-segment-id",
        segment_id,
    ]

    if dry_run:
        args.append("--dry-run")

    return {
        "name": f"rts24-{segment_code}-{job_name}-{trading_date}",
        "job_driver": {
            "sparkSubmit": {
                "entryPoint": f"{job_base}/{ENTRYPOINT_FILE}",
                "sparkSubmitParameters": SPARK_SUBMIT_PARAMETERS,
                "entryPointArguments": args,
            },
        },
    }


def create_task_group(segment_code: str, segment_id: str, trading_date: str) -> TaskGroup:
    """Create a TaskGroup per segment: run all flows, then the per-segment generation job."""
    application_id_jinja = (
        "{{ var.value.get('" + ENV_UPPER + "_LUNA_CASH_REGULATORY_REPORTING_EMR_APPLICATION_ID') }}"
    )
    execution_role_jinja = (
        "{{ var.value.get('" + ENV_UPPER + "_LUNA_CASH_REGULATORY_REPORTING_EMR_ROLE') }}"
    )

    with TaskGroup(group_id=f"process_segment_{segment_code}") as tg:
        flow_tasks: List[EmrServerlessStartJobOperator] = []

        for flow_name, job_name in MARKET_EVENT_FAMILIES_PER_SEGMENT.get(segment_code, []):
            # entries are (flow_name, job_name) tuples; job_name is required.
            t = EmrServerlessStartJobOperator(
                task_id=f"run_{flow_name}_emr_job",
                **build_emr_job_params(flow_name, segment_code, segment_id, trading_date, job_name),
                application_id=application_id_jinja,
                execution_role_arn=execution_role_jinja,
                deferrable=True,
                on_execute_callback=log_emr_job_start,
                config={"tags": EMR_CONFIG_TAGS},
                **EMR_RETRY_POLICY,
            )

            flow_tasks.append(t)

        gen = EmrServerlessStartJobOperator(
            task_id="run_generate_file_emr_job",
            **build_file_generation_emr_job(
                "c_reg_8_rts24_generation", segment_code, segment_id, trading_date
            ),
            application_id=application_id_jinja,
            execution_role_arn=execution_role_jinja,
            deferrable=True,
            on_execute_callback=log_emr_job_start,
            config={"tags": EMR_CONFIG_TAGS},
            **EMR_RETRY_POLICY,
        )

        for t in flow_tasks:
            t >> gen

    return tg


def create_all_flows(trading_date: str) -> List[TaskGroup]:
    """Create one TaskGroup per segment (parallel across segments)."""
    return [
        create_task_group(segment_code, segment_id, trading_date)
        for segment_code, segment_id in SEGMENT_CODE_TO_ID.items()
    ]


# Use plain dicts for Athena rows; no dataclass wrapper required.


@task
def fetch_athena_and_build_emr_params() -> List[Dict[str, Any]]:
    """Fetch Athena results and build EMR params for each row.

    This task pulls the `query_execution_id` from XCom (from `run_athena_query`),
    fetches results, and transforms each row into EMR operator params.
    Returns a list of dicts with keys `name` and `job_driver`.
    """
    from airflow.operators.python import get_current_context

    ctx = get_current_context()
    ti = ctx["ti"]
    trading_date = ti.xcom_pull(task_ids="extract_trading_date")

    dry_run = Variable.get("DRY_RUN_ATHENA", "false").lower() in ("1", "true", "yes")
    if dry_run:
        # sample rows for Airflow dry-run tests
        sample_rows: List[Dict[str, Any]] = [
            {"trading_date": "2026-05-01", "isin_code": "FR0001234567", "mic_code": "XPAR"},
        ]
        return [p for p in (build_emr_params_for_row(r, trading_date) for r in sample_rows) if p]

    qid = ti.xcom_pull(task_ids="run_athena_query")
    if not qid:
        return []

    hook = AthenaHook(aws_conn_id=AWS_CONN_ID)
    paginator = hook.get_query_results_paginator(qid)
    params_list: List[Dict[str, Any]] = []
    is_first_row = True  # Skip header row

    if paginator:
        for page in paginator:
            rs = page.get("ResultSet", {})
            meta = rs.get("ResultSetMetadata", {})
            col_info = meta.get("ColumnInfo", [])
            col_names = [c.get("Name") for c in col_info] if col_info else []
            rows = rs.get("Rows", [])

            for row in rows:
                # Skip the header row (first row contains column names as values)
                if is_first_row:
                    is_first_row = False
                    continue

                data_cells = row.get("Data", [])
                row_dict: Dict[str, Any] = {}
                for i, cell in enumerate(data_cells):
                    name = col_names[i] if i < len(col_names) else f"col_{i}"
                    row_dict[name] = cell.get("VarCharValue")

                # Build EMR params for this row
                emr_params = build_emr_params_for_row(row_dict, trading_date)
                if emr_params:
                    params_list.append(emr_params)

    return params_list


@task
def submit_emr_for_row(row: Dict[str, Any]) -> Optional[Dict[str, Any]]:
    """Submit an EMR Serverless job for a single Athena row.

    Returns a structured dict describing the submission outcome:
    - {'row': <row>, 'job_run_id': '<id>', 'success': True} on started job
    - {'row': <row>, 'success': False, 'skipped': True, 'reason': '...'} when skipped
    - {'row': <row>, 'success': False, 'error': '...'} on submission error

    This avoids raising on per-row failures so other mapped submissions can proceed.
    """
    if not row:
        return None

    # detect segment code and flow name from common column names
    seg_candidates = [
        "segment_code",
        "segment",
        "optiq_segment_id",
        "optiq_segment",
        "segment_id",
        "segmentCode",
    ]
    flow_candidates = [
        "market_event_family",
        "family",
        "flow_name",
        "event_family",
    ]

    segment_code = next((row.get(c) for c in seg_candidates if c in row), None)
    flow_name = next((row.get(c) for c in flow_candidates if c in row), None)

    if not segment_code or not flow_name:
        logger.warning("submit_emr_for_row: missing segment_code or flow_name, skipping row: %s", row)
        return {"row": row, "success": False, "skipped": True, "reason": "missing segment_code or flow_name"}

    # find configured job_name for this (segment, flow)
    job_name = None
    for fn, jn in MARKET_EVENT_FAMILIES_PER_SEGMENT.get(segment_code, []):
        if fn == flow_name:
            job_name = jn
            break

    if not job_name:
        logger.warning("submit_emr_for_row: no job mapping for %s in %s, skipping", flow_name, segment_code)
        return {"row": row, "success": False, "skipped": True, "reason": "no job mapping"}

    segment_id = (
        SEGMENT_CODE_TO_ID.get(segment_code)
        or row.get("segment_id")
        or row.get("optiq_segment_id")
    )
    if not segment_id:
        logger.warning("submit_emr_for_row: unknown segment_id for %s, skipping", segment_code)
        return {"row": row, "success": False, "skipped": True, "reason": "unknown segment_id"}

    # get trading_date from XCom (extract_trading_date task)
    from airflow.operators.python import get_current_context

    ctx = get_current_context()
    ti = ctx["ti"]
    trading_date_local = ti.xcom_pull(task_ids="extract_trading_date")

    # build job params and attach the request payload
    job_params = build_emr_job_params(flow_name, segment_code, segment_id, trading_date_local, job_name)
    try:
        row_json = json.dumps(row, ensure_ascii=False)
    except Exception:
        row_json = str(row)

    job_params["job_driver"]["sparkSubmit"]["entryPointArguments"].extend(["--request-json", row_json])

    # submit via boto3 EMR Serverless start_job_run
    application_id = Variable.get(
        f"{ENV_UPPER}_LUNA_CASH_REGULATORY_REPORTING_EMR_APPLICATION_ID",
        LOCAL_EMR_APPLICATION_ID,
    )
    execution_role_arn = Variable.get(
        f"{ENV_UPPER}_LUNA_CASH_REGULATORY_REPORTING_EMR_ROLE",
        LOCAL_EMR_EXECUTION_ROLE_ARN,
    )

    client = boto3.client("emr-serverless")
    try:
        resp = client.start_job_run(
            applicationId=application_id,
            executionRoleArn=execution_role_arn,
            jobDriver=job_params["job_driver"],
            name=job_params["name"],
            configurationOverrides={},
            tags=EMR_CONFIG_TAGS,
        )
        job_run_id = resp.get("jobRunId") or resp.get("id") or resp.get("JobRunId")
        logger.info("Started EMR Serverless job %s -> %s", job_params["name"], job_run_id)
        return {"row": row, "job_run_id": job_run_id, "success": True}
    except Exception as exc:
        logger.exception("Failed to start EMR job for %s: %s", job_params["name"], exc)
        # Do not raise here so other mapped submissions can still proceed; mark as failed
        return {"row": row, "success": False, "error": str(exc)}


def build_emr_params_for_row(row: Dict[str, Any], trading_date: str) -> Optional[Dict[str, Any]]:
    """Build EMR operator params for a single Athena row.

    Returns a dict with keys `name` and `job_driver` suitable for
    EmrServerlessStartJobOperator, or None if row is empty.
    """
    if not row:
        return None

    def _get_ci_value(keys: List[str]) -> Optional[str]:
        """Case-insensitive lookup for `row` and return trimmed string or None."""
        for k in row.keys():
            if k.lower() in keys:
                v = row.get(k)
                if v is None:
                    return None
                if isinstance(v, str):
                    s = v.strip()
                    return s if s != "" else None
                return str(v)
        return None

    # Use the standard file-generation job as the on-demand entrypoint
    job_name = "c_reg_8_rts24_generation"
    job_base = f"{JOBS_BASE_PATH}/{job_name}"

    # Determine trading_date: prefer per-row value, otherwise DAG-level
    row_td = _get_ci_value(["trading_date", "tradingdate", "trade_date"])

    # optional on-demand filters (case-insensitive keys)
    mic = _get_ci_value(["mic_code", "mic", "miccode"])
    isin = _get_ci_value(["isin_code", "isin"])
    participant = _get_ci_value(["participant_id", "participant", "participantid"])

    args: List[str] = ["--env", ENV_LOWER]
    if row_td:
        args.extend(["--trading-date", str(row_td)])
    args.extend([
        "--config",
        f"{job_base}/{CONFIG_FILE}",
        "--sql-base-path",
        f"{job_base}/{SQL_BASE_SUBPATH}",
    ])

    if mic:
        args.extend(["--mic-code", str(mic)])
    if isin:
        args.extend(["--isin-code", str(isin)])
    if participant:
        args.extend(["--participant-id", str(participant)])

    job_driver = {
        "sparkSubmit": {
            "entryPoint": f"{job_base}/{ENTRYPOINT_FILE}",
            "sparkSubmitParameters": SPARK_SUBMIT_PARAMETERS,
            "entryPointArguments": args,
        }
    }

    # Build job name with ondemand, job_name, and params
    # EMR Serverless job name limit is 256 characters
    name_parts = ["rts24-demand", job_name]
    if mic:
        name_parts.append(f"mic_{mic}")
    if isin:
        name_parts.append(f"isin_{isin}")
    if participant:
        name_parts.append(f"participant_{participant}")
    if row_td:
        name_parts.append(row_td)
    name = "-".join(name_parts)
    # Truncate to 256 chars at last separator if needed
    if len(name) > 256:
        truncated = name[:256]
        # Find last separator to avoid cutting mid-word
        last_sep = max(truncated.rfind("-"), truncated.rfind("_"))
        if last_sep > 0:
            name = truncated[:last_sep]
        else:
            name = truncated

    return {"name": name, "job_driver": job_driver}


@task
def filter_successful_submissions(
    submissions: List[Optional[Dict[str, Any]]]
) -> List[Dict[str, Any]]:
    """Filter the list of submission results returned by mapped `submit_emr_for_row`.

    `submit_emr_for_row` returns the original row dict on success or `None`/falsy
    when skipped/failed. This task collects the mapped results and returns only
    the truthy rows so downstream mapped UPDATEs are created only for successes.
    """
    # NOTE: filtering removed by user request; this placeholder remains for
    # historical reasons but will not be used.
    if not submissions:
        logger.info("filter_successful_submissions: no submissions, returning empty list")
        return []

    # Default: return only entries explicitly marked as success
    filtered = [s for s in submissions if s and s.get("success")]
    logger.info(
        "filter_successful_submissions: filtered %d -> %d (kept successes)",
        len(submissions),
        len(filtered),
    )
    return filtered


# ==============================================================================
# DAG Definition
# ==============================================================================
with DAG(
    dag_id=DAG_ID,
    description=(
        "rts24 market events data processing - triggered by the completion of trading "
        "data ingestion."
    ),
    schedule=[saturn_slc_ready_asset, trd_data_ready_asset],
    start_date=DAG_START_DATE,
    max_active_runs=DAG_MAX_ACTIVE_RUNS,
    catchup=False,
    tags=TAGS,
    doc_md=__doc__,
) as dag:
    extract_date = extract_trading_date()
    trading_date = "{{ ti.xcom_pull(task_ids='extract_trading_date') }}"

    # all_flows = create_all_flows(trading_date)

    # extract_date >> all_flows

    # ========== OLD 3-TASK VERSION (COMMENTED OUT) ==========
    # athena_query_task = AthenaOperator(
    #     task_id="run_athena_query",
    #     query="""
    #     SELECT *
    #     FROM ref_param_rts24_ondemand
    #     -- WHERE trading_date = '{{ ti.xcom_pull(task_ids="extract_trading_date") }}' ;
    #     """,
    #     database="dev_luna_cash_lakehouse_core_db",
    #     #dev-luna-cash-data-systems
    #     workgroup="primary",
    #     # workgroup="{{ var.value.get('ATHENA_WORKGROUP', 'primary') }}",
    # )

    # wait_for_athena = AthenaSensor(
    #     task_id="wait_for_athena_query",
    #     query_execution_id="{{ ti.xcom_pull(task_ids='run_athena_query') }}",
    #     poke_interval=30,
    #     timeout=60 * 60,  # 1 hour
    # )

    # # Fetch Athena results and build EMR params in one task
    # emr_params = fetch_athena_and_build_emr_params()
    # ========== END OLD 3-TASK VERSION ==========

    # ========== NEW 1-TASK VERSION (COMBINED) ==========
    @task
    def run_athena_and_build_emr_params(**context):
        """Run Athena query, wait for completion, and build EMR params in one task."""
        from airflow.providers.amazon.aws.hooks.athena import AthenaHook

        ti = context["ti"]
        trading_date_val = ti.xcom_pull(task_ids="extract_trading_date")

        athena_hook = AthenaHook(aws_conn_id=AWS_CONN_ID)

        # Check for dry run mode
        dry_run = Variable.get("DRY_RUN_ATHENA", "false").lower() in ("1", "true", "yes")
        if dry_run:
            logger.info("DRY_RUN_ATHENA enabled, returning sample data")
            sample_rows = [
                {"trading_date": "2026-05-01", "isin_code": "FR0001234567", "mic_code": "XPAR"},
            ]
            return [p for p in (build_emr_params_for_row(r, trading_date_val) for r in sample_rows) if p]

        # Run query and get execution ID
        query_execution_id = athena_hook.run_query(
            query="""
            SELECT *
            FROM ref_param_rts24_ondemand
            """,
            query_context={"Database": "dev_luna_cash_lakehouse_core_db"},
            result_configuration={},
            workgroup="primary",
        )

        logger.info(f"Athena query started: {query_execution_id}")

        # Wait for query to complete (replaces AthenaSensor)
        athena_hook.poll_query_status(
            query_execution_id=query_execution_id,
            max_polling_attempts=120,  # 120 attempts * 30s = 1 hour
            sleep_time=30,
        )

        logger.info(f"Athena query completed: {query_execution_id}")

        # Fetch results and build EMR params
        params_list = []
        paginator = athena_hook.get_query_results_paginator(query_execution_id)
        is_first_row = True

        if paginator:
            for page in paginator:
                rs = page.get("ResultSet", {})
                meta = rs.get("ResultSetMetadata", {})
                col_info = meta.get("ColumnInfo", [])
                col_names = [c.get("Name") for c in col_info] if col_info else []
                rows = rs.get("Rows", [])

                for row in rows:
                    # Skip header row
                    if is_first_row:
                        is_first_row = False
                        continue

                    data_cells = row.get("Data", [])
                    row_dict = {}
                    for i, cell in enumerate(data_cells):
                        name = col_names[i] if i < len(col_names) else f"col_{i}"
                        row_dict[name] = cell.get("VarCharValue")

                    # Build EMR params for this row
                    emr_params = build_emr_params_for_row(row_dict, trading_date_val)
                    if emr_params:
                        params_list.append(emr_params)

        logger.info(f"Built EMR params for {len(params_list)} rows")
        return params_list

    # Use the new combined task
    emr_params = run_athena_and_build_emr_params()
    # ========== END NEW 1-TASK VERSION ==========

    application_id_jinja = (
        "{{ var.value.get('" + ENV_UPPER + "_LUNA_CASH_REGULATORY_REPORTING_EMR_APPLICATION_ID') }}"
    )
    execution_role_jinja = (
        "{{ var.value.get('" + ENV_UPPER + "_LUNA_CASH_REGULATORY_REPORTING_EMR_ROLE') }}"
    )

    # Run EMR job for each row (mapped over emr_params output)
    emr_start = EmrServerlessStartJobOperator.partial(
        task_id="run_row_emr_job",
        map_index_template="{{ task.name }}",
        application_id=application_id_jinja,
        execution_role_arn=execution_role_jinja,
        deferrable=True,
        on_execute_callback=log_emr_job_start,
        config={"tags": EMR_CONFIG_TAGS},
        **EMR_RETRY_POLICY,
    ).expand_kwargs(emr_params)

    # ========== OLD 3-TASK DEPENDENCIES (COMMENTED OUT) ==========
    # extract_date >> athena_query_task
    # athena_query_task >> wait_for_athena
    # wait_for_athena >> emr_params
    # emr_params >> emr_start
    # ========== END OLD DEPENDENCIES ==========

    # ========== NEW 1-TASK DEPENDENCIES ==========
    # Single task combines query + wait + build
    extract_date >> emr_params >> emr_start
    # ========== END NEW DEPENDENCIES ==========